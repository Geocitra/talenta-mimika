DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mimika-talenta-db?schema=public"
JWT_SECRET="GantiDenganSecretKeyMinimal32KarakterYangKuatDanAman"

# =========================================================
# SMTP CONFIGURATION (EMAIL SERVICE)
# =========================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="MIMIKA TALENTA <noreply@mimika.go.id>"

# =========================================================
# API INDONESIA (Master Data Sekolah & Kampus)
# =========================================================
API_INDONESIA_KEY="your-api-indonesia-key"
API_INDONESIA_BASE_URL="https://use.apiindonesia.id/api/v1"

# =========================================================
# HYBRID AI & COGNITIVE AGENTS (OPENAI INTEGRATION)
# =========================================================
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
